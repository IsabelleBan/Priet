  .custom-product__add-btn,
  .custom-product__select-wrapper,
  .custom-product__engraving,
  .custom-product__diamond-type-options,
  .custom-product__shape-options,
  .custom-product__carat-options,
  .custom-product__quality-options,
  .custom-product__diamond-btn { max-width: 100%; }
}

{% endstylesheet %}

<script>
(function() {

  // VARIANT SELECTION
  var selectedOptions = {};
  var productData = {{ product.variants | json }};

  function updateVariant() {
    var optionValues = Object.values(selectedOptions);
    var matchedVariant = productData.find(function(v) {
      return v.options.every(function(opt, i) {
        return !optionValues[i] || opt === optionValues[i];
      });
    });
    if (matchedVariant) {
      document.getElementById('variant-id').value = matchedVariant.id;
      document.getElementById('product-price').textContent = 'From ' + (matchedVariant.price / 100).toLocaleString('sv-SE', { style: 'currency', currency: 'SEK', maximumFractionDigits: 0 });
    }
  }

  document.querySelectorAll('.custom-product__option-btns').forEach(function(group) {
    var optionIndex = parseInt(group.getAttribute('data-option-index')) - 1;
    group.querySelectorAll('.custom-product__option-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        group.querySelectorAll('.custom-product__option-btn').forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');
        selectedOptions[optionIndex] = this.getAttribute('data-value');
        updateVariant();
      });
      if (btn.classList.contains('active')) {
        selectedOptions[optionIndex] = btn.getAttribute('data-value');
      }
    });
  });

  // FINISH + WIDTH FILTRERING
  var finishInput = document.getElementById('finish-choice');
  var widthInput = document.getElementById('width-choice');
  var allSlides = document.querySelectorAll('.custom-product__image-slide');
  var selectedFinish = finishInput ? finishInput.value.toLowerCase() : null;
  var selectedWidth = null;

  var firstWidthBtn = document.querySelector('.custom-product__width-btn');
  if (firstWidthBtn) {
    firstWidthBtn.classList.add('active');
    selectedWidth = firstWidthBtn.getAttribute('data-width');
    if (widthInput) widthInput.value = selectedWidth;
  }

  function filterImages() {
    allSlides.forEach(function(slide) {
      var slideFinish = slide.getAttribute('data-finish');
      var slideWidth = slide.getAttribute('data-width');
      if (!slideFinish && !slideWidth) { slide.style.display = 'block'; return; }
      var finishMatch = !slideFinish || !selectedFinish || slideFinish === selectedFinish;
      var widthMatch = !slideWidth || !selectedWidth || slideWidth === selectedWidth;
      slide.style.display = (finishMatch && widthMatch) ? 'block' : 'none';
    });
  }

  document.querySelectorAll('.custom-product__finish-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.custom-product__finish-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      var finish = this.getAttribute('data-finish');
      if (finishInput) finishInput.value = finish;
      selectedFinish = finish.toLowerCase();
      filterImages();
    });
  });

  document.querySelectorAll('.custom-product__width-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.custom-product__width-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      var width = this.getAttribute('data-width');
      if (widthInput) widthInput.value = width;
      selectedWidth = width.toLowerCase().replace(' ', '');
      filterImages();
    });
  });

  // ACCORDION
  document.querySelectorAll('.custom-product__accordion-header').forEach(function(header) {
    header.addEventListener('click', function() {
      var body = this.nextElementSibling;
      var isOpen = this.classList.contains('open');
      document.querySelectorAll('.custom-product__accordion-header').forEach(function(h) {
        h.classList.remove('open');
        h.nextElementSibling.style.display = 'none';
      });
      if (!isOpen) {
        this.classList.add('open');
        body.style.display = 'block';
      }
    });
  });

  filterImages();

  // DIAMOND SELECTOR
  var diamondBtn = document.getElementById('choose-diamond-btn');
  var selectedDiamondType = 'lab';
  var selectedShape = 'ROUND';
  var selectedCarat = '0.50';
  var selectedQuality = 'good';

  var diamondVariants = {
    '0.50': { 'good': 53481640886615, 'very-good': 53481640919383, 'perfect': 53481640952151 },
    '1.00': { 'good': 53481640984919, 'very-good': 53481641017687, 'perfect': 53481641050455 },
    '1.50': { 'good': 53481641083223, 'very-good': 53481641115991, 'perfect': 53481641148759 },
    '2.00': { 'good': 53481641181527, 'very-good': 53481641214295, 'perfect': 53481641247063 },
  };

  var priceMap = {
    '0.50': { 'good': 7000, 'very-good': 9000, 'perfect': 11000 },
    '1.00': { 'good': 20000, 'very-good': 25000, 'perfect': 32000 },
    '1.50': { 'good': 38000, 'very-good': 48000, 'perfect': 63000 },
    '2.00': { 'good': 42000, 'very-good': 52000, 'perfect': 67000 },
  };

  function updateDiamondVariant() {
    var input = document.getElementById('diamond-variant-id');
    if (!input) return;
    if (selectedShape === 'ROUND' && diamondVariants[selectedCarat] && diamondVariants[selectedCarat][selectedQuality]) {
      input.value = diamondVariants[selectedCarat][selectedQuality];
    } else {
      input.value = '';
    }
  }

  function updateDiamondUrl() {
    if (!diamondBtn) return;
    var variantId = document.getElementById('variant-id').value;
    var ring = '{{ product.handle }}';
    diamondBtn.href = '/pages/choose-diamond?variant=' + variantId
      + '&ring=' + ring
      + '&type=' + selectedDiamondType
      + '&shape=' + selectedShape
      + '&carat=' + selectedCarat;
  }

  function updateDiamondUI() {
    var standardOption = document.getElementById('standard-diamond-option');
    var standardQuality = document.getElementById('standard-quality-option');
    var apiOption = document.getElementById('api-diamond-option');
    if (selectedShape === 'ROUND') {
      if (standardOption) standardOption.style.display = 'block';
      if (standardQuality) standardQuality.style.display = 'block';
      if (apiOption) apiOption.style.display = 'none';
    } else {
      if (standardOption) standardOption.style.display = 'none';
      if (standardQuality) standardQuality.style.display = 'none';
      if (apiOption) apiOption.style.display = 'block';
    }
    updateDiamondVariant();
    updateDiamondUrl();
  }

  document.querySelectorAll('.custom-product__diamond-type-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.custom-product__diamond-type-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      selectedDiamondType = this.getAttribute('data-type');
      updateDiamondUrl();
    });
  });

  document.querySelectorAll('.custom-product__shape-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.custom-product__shape-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      selectedShape = this.getAttribute('data-shape');
      updateDiamondUI();
    });
  });

  document.querySelectorAll('.custom-product__carat-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.custom-product__carat-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      selectedCarat = this.getAttribute('data-carat');
      updateDiamondVariant();
      updateDiamondUrl();
    });
  });

  document.querySelectorAll('.custom-product__quality-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.custom-product__quality-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      selectedQuality = this.getAttribute('data-quality');
      updateDiamondVariant();
    });
  });

  updateDiamondUI();

  // ADD TO CART
  var SIZE_ADJUSTMENT_VARIANT_ID = 53104121774423;
  var SIZE_ADJUSTMENT_FROM_INDEX = 27;
  var form = document.getElementById('custom-product-form');
  var sizeSelect = document.getElementById('ring-size-select');
  var addBtn = document.getElementById('add-to-bag');

  if (!form) return;

  function buildProperties() {
    var props = {};
    var inputs = form.querySelectorAll('[name^="properties["]');
    inputs.forEach(function(input) {
      var match = input.name.match(/properties\[(.+)\]/);
      if (match && input.value) props[match[1]] = input.value;
    });
    return props;
  }

  function addToCart(id, quantity, properties) {
    var body = { id: id, quantity: quantity };
    if (properties) body.properties = properties;
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    }).then(function(res) {
      return res.json().then(function(data) {
        if (!res.ok) {
          console.error('Cart add error for id ' + id + ':', JSON.stringify(data));
          throw new Error(data.description || 'Cart error');
        }
        return data;
      });
    });
  }

  addBtn.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();

    var variantId = parseInt(document.getElementById('variant-id').value);
    var diamondVariantId = parseInt(document.getElementById('diamond-variant-id').value);
    var needsAdjustment = sizeSelect && sizeSelect.value !== '' && sizeSelect.selectedIndex >= SIZE_ADJUSTMENT_FROM_INDEX;

    addBtn.textContent = 'ADDING...';
    addBtn.disabled = true;

    var props = buildProperties();
    delete props['Diamond'];

    if (selectedShape === 'ROUND' && diamondVariantId) {
      var qualityLabel = selectedQuality === 'good' ? 'Bra' : selectedQuality === 'very-good' ? 'Mycket bra' : 'Perfekt';
      var diamondPrice = priceMap[selectedCarat][selectedQuality];
      props['Diamond'] = selectedCarat + 'ct · ' + qualityLabel + ' · ' + diamondPrice.toLocaleString('sv-SE') + ' kr';
    }

    addToCart(variantId, 1, props)
      .then(function() {
        if (selectedShape === 'ROUND' && diamondVariantId) {
          return addToCart(diamondVariantId, 1, { '_surcharge': 'true' });
        }
        return Promise.resolve();
      })
      .then(function() {
        if (!needsAdjustment) {
          window.location.href = '/cart';
          return Promise.resolve();
        }
        return fetch('/cart.js').then(function(r) { return r.json(); });
      })
      .then(function(cart) {
        if (!cart || !cart.items) return;
        var ringItem = cart.items.find(function(item) {
          return item.variant_id === variantId;
        });
        var mainItemKey = ringItem ? ringItem.key : null;
        return addToCart(SIZE_ADJUSTMENT_VARIANT_ID, 1, {
          '_surcharge': 'true',
          '_for_key': mainItemKey
        });
      })
      .then(function() {
        window.location.href = '/cart';
      })
      .catch(function(err) {
        console.error('Final error:', err.message);
        addBtn.textContent = 'ADD TO BAG';
        addBtn.disabled = false;
      });
  });

})();
</script>

